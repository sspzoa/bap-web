# API base. Punycode default is production (https://api.밥.net).
# NEXT_PUBLIC_API_BASE_URL=https://api.xn--rh3b.net

# Kakao AdFit unit ids from the AdFit dashboard (밥.net must be an approved web media).
# Leave empty to hide that placement. Values are inlined at build time.
# MOBILE (320x100): narrow home, and the time-default mobile meal card
# (getCurrentMealTiming). The school picker has no ad.
# PC (728x90): wide home, and below the meal cards on wide meal screens.
# PC (728x90): wide home, and below the meal cards on wide meal screens.
# NEXT_PUBLIC_ADFIT_UNIT_MOBILE=
# NEXT_PUBLIC_ADFIT_UNIT_PC=
